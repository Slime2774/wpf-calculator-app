<Window x:Class="WpfCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="ООП Калькулятор" Height="450" Width="350" MinWidth="350" MinHeight="450"
        KeyDown="Window_KeyDown" WindowStartupLocation="CenterScreen" Background="#F3F3F3">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="5">
            <MenuItem Header="Вид">
                <MenuItem Header="Расширенный режим" IsCheckable="True" Checked="ToggleExtendedMode" Unchecked="ToggleExtendedMode"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="История вычислений (О программе)" Click="ShowAbout"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ExtraColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtDisplay" Grid.Row="0" Grid.ColumnSpan="2" 
                     Height="60" Margin="0,0,0,10" 
                     TextAlignment="Right" FontSize="28" FontWeight="Light"
                     VerticalContentAlignment="Center" Background="White" 
                     IsReadOnly="True" BorderBrush="#CCCCCC" BorderThickness="1" 
                     Padding="10,0"/>

            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="CE" Grid.Row="0" Grid.Column="0" Margin="2" Click="Clear_Click" Background="#EAEAEA" FontSize="14"/>
                <Button Content="C" Grid.Row="0" Grid.Column="1" Margin="2" Click="Clear_Click" Background="#EAEAEA" FontSize="14"/>
                <Button Content="⌫" Grid.Row="0" Grid.Column="2" Margin="2" Click="Back_Click" Background="#EAEAEA" FontSize="14"/>
                <Button Content="/" Grid.Row="0" Grid.Column="3" Margin="2" Click="Op_Click" Background="#F1A33C" Foreground="White" FontSize="16" FontWeight="Bold"/>

                <Button Content="x²" Grid.Row="1" Grid.Column="0" Margin="2" Click="Square_Click" Background="#F9F9F9" FontSize="14"/>
                <Button Content="√" Grid.Row="1" Grid.Column="1" Margin="2" Click="Root_Click" Background="#F9F9F9" FontSize="14"/>
                <Button Content="%" Grid.Row="1" Grid.Column="2" Margin="2" Click="Percent_Click" Background="#F9F9F9" FontSize="14"/>
                <Button Content="*" Grid.Row="1" Grid.Column="3" Margin="2" Click="Op_Click" Background="#F1A33C" Foreground="White" FontSize="16" FontWeight="Bold"/>

                <Button Content="7" Grid.Row="2" Grid.Column="0" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="8" Grid.Row="2" Grid.Column="1" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="9" Grid.Row="2" Grid.Column="2" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="-" Grid.Row="2" Grid.Column="3" Margin="2" Click="Op_Click" Background="#F1A33C" Foreground="White" FontSize="16" FontWeight="Bold"/>

                <Button Content="4" Grid.Row="3" Grid.Column="0" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="5" Grid.Row="3" Grid.Column="1" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="6" Grid.Row="3" Grid.Column="2" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="+" Grid.Row="3" Grid.Column="3" Margin="2" Click="Op_Click" Background="#F1A33C" Foreground="White" FontSize="16" FontWeight="Bold"/>

                <Button Content="1" Grid.Row="4" Grid.Column="0" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="2" Grid.Row="4" Grid.Column="1" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="3" Grid.Row="4" Grid.Column="2" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="1/x" Grid.Row="4" Grid.Column="3" Margin="2" Click="Reciprocal_Click" Background="#F9F9F9" FontSize="14"/>

                <Button Content="±" Grid.Row="5" Grid.Column="0" Margin="2" Click="Sign_Click" Background="White" FontSize="16"/>
                <Button Content="0" Grid.Row="5" Grid.Column="1" Margin="2" Click="Digit_Click" Background="White" FontSize="16"/>
                <Button Content="," Grid.Row="5" Grid.Column="2" Margin="2" Click="Point_Click" Background="White" FontSize="16"/>
                <Button Content="=" Grid.Row="5" Grid.Column="3" Margin="2" Click="Equal_Click" Background="#E08300" Foreground="White" FontSize="18" FontWeight="Bold"/>
            </Grid>

            <Grid x:Name="ExtraPanel" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Button Content="ln" Grid.Row="0" Margin="2" Click="Ln_Click" Background="#DFE4EA" FontSize="14" FontWeight="Medium"/>
                <Button Content="π" Grid.Row="1" Margin="2" Click="Pi_Click" Background="#DFE4EA" FontSize="14"/>
                <Button Content="e" Grid.Row="2" Margin="2" Click="E_Click" Background="#DFE4EA" FontSize="14"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>